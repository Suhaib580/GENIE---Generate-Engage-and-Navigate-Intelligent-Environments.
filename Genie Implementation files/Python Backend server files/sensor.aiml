        <template><srai>CHECK EVERYTHING</srai></template></category>
    <category><pattern>ARE THINGS OK</pattern>
        <template><srai>CHECK EVERYTHING</srai></template></category>
    <category><pattern>WHAT IS YOUR STATUS</pattern>
        <template><srai>CHECK EVERYTHING</srai></template></category>
    <category><pattern>STATUS REPORT</pattern>
        <template><srai>CHECK EVERYTHING</srai></template></category>
    <category><pattern>CHECK ALL SENSORS</pattern>
        <template><srai>CHECK EVERYTHING</srai></template></category>
    <category><pattern>HOW ARE THE SENSORS</pattern>
        <template><srai>CHECK EVERYTHING</srai></template></category>
    <category><pattern>GIVE ME A REPORT</pattern>
        <template><srai>CHECK EVERYTHING</srai></template></category>
    <category><pattern>HOW IS THE ROOM</pattern>
        <template><srai>CHECK EVERYTHING</srai></template></category>
    <category><pattern>CHECK ALL THE SENSORS</pattern>
        <template><srai>CHECK EVERYTHING</srai></template></category>

    <!-- ====================================================== -->
    <!--                COMMON SENSOR RESPONSE                  -->
    <!--                                                        -->
    <!--  Every <condition> ends with a bare <li> default. That -->
    <!--  is not decoration: without it, an unset predicate      -->
    <!--  makes AIML return an empty string and Genie says       -->
    <!--  nothing at all, which reads as a crash.                -->
    <!-- ====================================================== -->

    <category>
        <pattern>CHECK SENSOR</pattern>
        <template>
            <condition name="sensor">

                <!-- ================= SMOKE ================= -->
                <li value="SMOKE">
                    <condition name="smoke_status">
                        <li value="alarm">
                            <random>
                                <li>Gas alarm. The reading is well above normal - please check the room now.</li>
                                <li>I am detecting a high level of gas or smoke. Please check immediately.</li>
                                <li>Warning. Smoke levels are high enough to be a concern.</li>
                            </random>
                        </li>
                        <li value="elevated">
                            <random>
                                <li>Smoke is slightly elevated, but not at alarm level yet.</li>
                                <li>I am reading a little more smoke than usual. Worth keeping an eye on.</li>
                                <li>Air quality has dipped slightly. Nothing serious so far.</li>
                            </random>
                        </li>
                        <li value="clear">
                            <random>
                                <li>No, I do not detect any smoke. The air is clear.</li>
                                <li>The air appears clear.</li>
                                <li>No signs of smoke or gas at the moment.</li>
                            </random>
                        </li>
                        <!-- boolean values, so the original ai.py still works -->
                        <li value="true">
                            <random>
                                <li>Yes, I detect smoke nearby.</li>
                                <li>Smoke has been detected.</li>
                            </random>
                        </li>
                        <li value="false">
                            <random>
                                <li>No, I do not detect any smoke.</li>
                                <li>The air appears clear.</li>
                            </random>
                        </li>
                        <li>I cannot read the smoke sensor right now. It may not be connected.</li>
                    </condition>
                </li>

                <!-- ================= FLAME ================= -->
                <li value="FLAME">
                    <condition name="flame_status">
                        <li value="alarm">
                            <random>
                                <li>Fire alarm. I am detecting a strong flame signature nearby.</li>
                                <li>Warning, I detect what looks like a fire. Please check immediately.</li>
                            </random>
                        </li>
                        <li value="detected">
                            <random>
                                <li>I detect an infrared source nearby. It may be a flame, or it may be a lamp or sunlight.</li>
                                <li>Something warm or bright is in front of me. I cannot be certain it is a fire.</li>
                            </random>
                        </li>
                        <li value="clear">
                            <random>
                                <li>No flame detected. Everything looks clear.</li>
                                <li>I do not see any sign of fire.</li>
                                <li>No fire detected nearby.</li>
                            </random>
                        </li>
                        <li value="true">Yes, I detect a flame nearby.</li>
                        <li value="false">No flame detected.</li>
                        <li>I cannot read the flame sensor right now. It may not be connected.</li>
                    </condition>
                </li>

                <!-- ================= IR ================= -->
                <li value="IR">
                    <condition name="ir_status">
                        <li value="true">
                            <random>
                                <li>Yes, I detect something in front of me.</li>
                                <li>There appears to be someone nearby.</li>
                                <li>I can sense something ahead.</li>
                                <li>Something is present in front of me.</li>
                            </random>
                        </li>
                        <li value="false">
                            <random>
                                <li>I do not detect anything nearby.</li>
                                <li>The area in front of me is clear.</li>
                                <li>Nothing appears to be in front of me.</li>
                            </random>
                        </li>
                        <li>I cannot read the presence sensor right now.</li>
                    </condition>
                </li>

                <!-- ================= MOTION ================= -->
                <li value="MOTION">
                    <condition name="motion_status">
                        <li value="true">
                            <random>
                                <li>Yes, I have been moved.</li>
                                <li>I felt a change in my position.</li>
                                <li>Something moved me recently.</li>
                            </random>
                        </li>
                        <li value="false">
                            <random>
                                <li>No movement has been detected. I have remained still.</li>
                                <li>Everything appears stable.</li>
                                <li>I do not sense any motion.</li>
                            </random>
                        </li>
                        <li>I cannot read the motion sensor right now.</li>
                    </condition>
                </li>

                <!-- ================= FALL ================= -->
                <li value="FALL">
                    <condition name="fall_status">
                        <li value="fallen">
                            <random>
                                <li>Yes. I detected a fall and there has been no movement since. Please check on them.</li>
                                <li>A fall was detected. Someone may need help right now.</li>
                            </random>
                        </li>
                        <li value="impact">
                            <random>
                                <li>I detected a sudden impact. I am checking whether someone has fallen.</li>
                                <li>Something hit the ground hard. Give me a moment to confirm.</li>
                            </random>
                        </li>
                        <li value="freefall">I am sensing a sudden drop right now.</li>
                        <li value="idle">
                            <random>
                                <li>No fall detected. Everything seems fine.</li>
                                <li>Nobody has fallen. All is well.</li>
                                <li>No fall events so far.</li>
                            </random>
                        </li>
                        <li>I cannot read the fall detector right now. It may not be connected.</li>
                    </condition>
                </li>

                <!-- ================= PRESENCE ================= -->
                <li value="PRESENCE">
                    <condition name="presence_status">
                        <li value="true">
                            <random>
                                <li>Yes, there is someone nearby.</li>
                                <li>I can sense somebody in the room.</li>
                                <li>Someone is close by.</li>
                            </random>
                        </li>
                        <li value="false">
                            <random>
                                <li>I do not sense anyone in the room.</li>
                                <li>The room seems empty from where I am.</li>
                                <li>Nobody is within range of my sensors.</li>
                            </random>
                        </li>
                        <li>I cannot check the room right now. My distance sensors are not reporting.</li>
                    </condition>
                </li>

                <!-- ================= DISTANCE ================= -->
                <li value="DISTANCE">
                    <condition name="distance">
                        <!-- value="" is an unset predicate: no valid reading
                             from any of the four sensors, or Node 2 is not
                             reporting at all. Say so rather than saying
                             "nothing is nearby". Those are different
                             answers and only one of them is honest. -->
                        <li value="">I cannot read the distance sensors right now. They may not be connected.</li>
                        <li>
                            <random>
                                <li>The nearest thing is about <get name="distance"/> centimetres away, <get name="distance_side"/>.</li>
                                <li>I read something about <get name="distance"/> centimetres away, <get name="distance_side"/>.</li>
                                <li>There is something roughly <get name="distance"/> centimetres <get name="distance_side"/>.</li>
                            </random>
                        </li>
                    </condition>
                </li>

                <!-- ================= TEMPERATURE ================= -->
                <li value="TEMPERATURE">
                    <condition name="temperature">
                        <!-- value="" matches an unset or cleared predicate.
                             A condition may have only ONE bare default <li>,
                             and it must be last, or the first one swallows
                             every case and Genie replies with nothing. -->
                        <li value="">I cannot read the temperature sensor right now. It may not be connected.</li>
                        <li>
                            <random>
                                <li>The current temperature is <get name="temperature"/> degrees Celsius.</li>
                                <li>I am reading <get name="temperature"/> degrees Celsius.</li>
                                <li>It is currently <get name="temperature"/> degrees Celsius.</li>
                            </random>
                        </li>
                    </condition>
                </li>

                <!-- ================= HUMIDITY ================= -->
                <li value="HUMIDITY">
                    <condition name="humidity">
                        <li value="">I cannot read the humidity sensor right now. It may not be connected.</li>
                        <li>
                            <random>
                                <li>The current humidity is <get name="humidity"/> percent.</li>
                                <li>The air humidity is currently <get name="humidity"/> percent.</li>
                                <li>Humidity around me is <get name="humidity"/> percent.</li>
                            </random>
                        </li>
                    </condition>
                </li>

                <!-- ================= KNOCK ================= -->
                <!-- The COUNT is the real answer here, not the flag. KNOCK
                     is only true for 2.5 seconds after a tap, so a poll that
                     lands a moment late reads false on a door somebody is
                     hammering. A lifetime counter cannot be missed that way,
                     so the "false" branch still reports it. -->
                <li value="KNOCK">
                    <condition name="knock_status">
                        <li value="true">
                            <random>
                                <li>Yes, I just felt a tap. That makes <get name="knock_count"/> since I started.</li>
                                <li>Somebody is knocking. I have counted <get name="knock_count"/> taps so far.</li>
                                <li>I am being tapped right now. <get name="knock_count"/> taps in total.</li>
                            </random>
                        </li>
                        <li value="false">
                            <condition name="knock_count">
                                <li value="">Nothing is tapping me at the moment.</li>
                                <li value="0">
                                    <random>
                                        <li>Nobody has knocked since I started.</li>
                                        <li>No taps at all so far.</li>
                                    </random>
                                </li>
                                <li>
                                    <random>
                                        <li>Nothing right now, though I have felt <get name="knock_count"/> taps since I started.</li>
                                        <li>No knock at the moment. <get name="knock_count"/> taps in total so far.</li>
                                    </random>
                                </li>
                            </condition>
                        </li>
                        <li>I cannot read the vibration sensor right now. It may not be connected.</li>
                    </condition>
                </li>

                <!-- ================= ALL ================= -->
                <li value="ALL">
                    <condition name="safety_status">
                        <li value="alarm">
                            It is <condition name="temperature"><li value="">an unreadable temperature</li><li><get name="temperature"/> degrees</li></condition> and <condition name="humidity"><li value="">unreadable humidity</li><li><get name="humidity"/> percent humidity</li></condition>,
                            but there is a safety alarm active. Please check the room immediately.
                        </li>
                        <li value="warning">
                            It is <condition name="temperature"><li value="">an unreadable temperature</li><li><get name="temperature"/> degrees</li></condition> and <condition name="humidity"><li value="">unreadable humidity</li><li><get name="humidity"/> percent humidity</li></condition>.
                            One of my safety sensors is slightly elevated, so I am keeping watch.
                        </li>
                        <li value="ok">
                            <random>
                                <li>Everything looks fine. It is <condition name="temperature"><li value="">an unreadable temperature</li><li><get name="temperature"/> degrees</li></condition> and <condition name="humidity"><li value="">unreadable humidity</li><li><get name="humidity"/> percent humidity</li></condition>, and no smoke, fire or falls detected.</li>
                                <li>All clear. <condition name="temperature"><li value="">an unreadable temperature</li><li><get name="temperature"/> degrees</li></condition>, <condition name="humidity"><li value="">unreadable humidity</li><li><get name="humidity"/> percent humidity</li></condition>, and all safety sensors are normal.</li>
                            </random>
                        </li>
                        <li>
                            It is <condition name="temperature"><li value="">an unreadable temperature</li><li><get name="temperature"/> degrees</li></condition> and <condition name="humidity"><li value="">unreadable humidity</li><li><get name="humidity"/> percent humidity</li></condition>.
                            I do not have a full safety reading right now.
                        </li>
                    </condition>
                </li>

                <!-- unknown sensor name -->
                <li>I am not sure which sensor you mean. You can ask about temperature, humidity, smoke, fire, movement, falls, or whether anyone is nearby.</li>
            </condition>
        </template>
    </category>

    <!-- Added: exact phrasings observed failing in a live session -->
    <!-- word order variant of the existing HOW HOT IS IT category -->
    <category>
        <pattern>HOW HOT IT IS</pattern>
        <template><srai>CHECK TEMPERATURE</srai></template>
    </category>
    <category><pattern>IS IT WARM</pattern>
        <template><srai>CHECK TEMPERATURE</srai></template></category>
    <category><pattern>WHAT IS THE TEMP</pattern>
        <template><srai>CHECK TEMPERATURE</srai></template></category>
    <category><pattern>IS IT COOL</pattern>
        <template><srai>CHECK TEMPERATURE</srai></template></category>
    <category><pattern>THE TEMPERATURE</pattern>
        <template><srai>CHECK TEMPERATURE</srai></template></category>
    <category><pattern>TEMPERATURE</pattern>
        <template><srai>CHECK TEMPERATURE</srai></template></category>

    <!-- singular "sensor" variants of the existing CHECK ALL SENSORS category -->
    <category>
        <pattern>CHECK ALL SENSOR</pattern>
        <template><srai>CHECK ALL SENSORS</srai></template>
    </category>

    <category>
        <pattern>CHECK FOR ALL SENSOR</pattern>
        <template><srai>CHECK ALL SENSORS</srai></template>
    </category>

    <category>
        <pattern>CHECK FOR ALL SENSORS</pattern>
        <template><srai>CHECK ALL SENSORS</srai></template>
    </category>

    <!-- "the fall sensor" variant of the existing CHECK FALL SENSOR category -->
    <category>
        <pattern>CHECK THE FALL SENSOR</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template>
    </category>

    <!-- Added 27-08-2026 after asking these out loud against live data.
         "HAS SOMEONE FALLEN" was covered and "HAS ANYONE FALLEN" was not.
         AIML matches whole patterns, so near-synonyms are not free, and a
         fall is the one question this device exists to answer. -->
    <category>
        <pattern>HAS ANYONE FALLEN</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template>
    </category>
    <category>
        <pattern>HAS ANYBODY FALLEN</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template>
    </category>
    <category>
        <pattern>HAS ANYONE FALLEN DOWN</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template>
    </category>
    <category>
        <pattern>DID ANYBODY FALL</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template>
    </category>
    <category>
        <pattern>HAS THERE BEEN A FALL</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template>
    </category>
    <category>
        <pattern>WAS THERE A FALL</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template>
    </category>
    <category>
        <pattern>IS ANYONE ON THE FLOOR</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template>
    </category>
    <category>
        <pattern>DID ANYONE FALL DOWN</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template>
    </category>
    <category>
        <pattern>DID SOMEONE FALL DOWN</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template>
    </category>
    <category>
        <pattern>ARE YOU OK</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template>
    </category>
    <category>
        <pattern>IS ANYONE INJURED</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template>
    </category>
    <category><pattern>HAVE YOU FALLEN</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template></category>
    <category><pattern>HAVE I FALLEN</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template></category>
    <category><pattern>DID SOMEBODY FALL</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template></category>
    <category><pattern>DID YOU FALL OVER</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template></category>
    <category><pattern>SOMEONE HAS FALLEN</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template></category>
    <category><pattern>SOMEBODY HAS FALLEN</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template></category>
    <category><pattern>SOMEONE FELL</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template></category>
    <category><pattern>I FELL</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template></category>
    <category><pattern>I HAVE FALLEN</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template></category>
    <category><pattern>THE FALL SENSOR</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template></category>
    <category><pattern>FALL SENSOR</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template></category>
    <category><pattern>THE FALL DETECTOR</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template></category>
    <category><pattern>FALL DETECTOR</pattern>
        <template><srai>CHECK FALL SENSOR</srai></template></category>

    <!-- ====================================================== -->
    <!--          HANDLING REACTIONS  -  unprompted             -->
    <!--                                                        -->
    <!--  Everything else in this file answers a question.      -->
    <!--  These are the only lines Genie says when nobody       -->
    <!--  asked: the IMU noticed it was shoved or picked up      -->
    <!--  (handling_fsm.py on the face board) and reaction_watch -->
    <!--  turns that into speech.                                -->
    <!--                                                        -->
    <!--  They live here rather than in Python so every word     -->
    <!--  Genie speaks stays in one file, and so each one gets    -->
    <!--  a <random> set. A device that says the exact same      -->
    <!--  sentence every single time it is nudged stops reading   -->
    <!--  as aware and starts reading as a doorbell.             -->
    <!-- ====================================================== -->

    <category>
        <pattern>REACTION EVENT</pattern>
        <template>
            <condition name="reaction">

                <li value="pushed">
                    <random>
                        <li>Hey. Why are you pushing me?</li>
                        <li>Please stop pushing me.</li>
                        <li>Ouch. That was a bit rough.</li>
                        <li>I felt that. Please be gentle.</li>
                    </random>
                </li>

                <li value="shaken">
                    <random>
                        <li>Please stop shaking me.</li>
                        <li>I am already off the ground. Shaking me does not help.</li>
                        <li>Steady, please. You are shaking me.</li>
                    </random>
                </li>

                <li value="lifted">
                    <random>
                        <li>Hey, put me down please.</li>
                        <li>I have been picked up. Please put me back.</li>
                        <li>Am I going somewhere? Please put me down.</li>
                    </random>
                </li>

                <li value="still_lifted">
                    <random>
                        <li>I am still in the air. Please put me down.</li>
                        <li>Still holding me. I would rather be on a table.</li>
                        <li>Please set me down somewhere flat.</li>
                    </random>
                </li>

                <li value="set_down">
                    <random>
                        <li>Thank you. That is better.</li>
                        <li>Much better. Thank you.</li>
                        <li>Back on solid ground. Thank you.</li>
                    </random>
                </li>

                <!-- Bare default, last, as everywhere else in this file:
                     an unknown reaction name must produce silence that the
                     caller can detect, never an empty string it might
                     hand to the speaker. -->
                <li></li>
            </condition>
        </template>
    </category>

</aiml>
