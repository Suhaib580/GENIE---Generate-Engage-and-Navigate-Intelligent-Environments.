<?xml version="1.0" encoding="UTF-8"?>

<!--
  GENIE sensor AIML  -  v2, 05-08-2026

  Extends the original with:
    * FLAME as its own sensor. "IS THERE A FIRE" used to route to SMOKE.
      The flame sensor reacts in ~200 ms; the MQ-2 needs smoke to physically
      reach it. For a fire question the flame sensor is the right answer.
    * FALL as its own sensor, separate from MOTION. A fall is a safety event,
      "did you move" is not. They deserve different words.
    * GRADED LEVELS instead of true/false. The MQ-2 reports clear / elevated /
      alarm and the flame sensor reports clear / detected / alarm. Collapsing
      those to a boolean throws away information the hardware already gives us.
      Boolean values are still accepted so the old ai.py keeps working.
    * UNAVAILABLE handling. If a sensor is not wired or has not reported yet,
      AIML used to fall through a <condition> and return an empty string, so
      Genie said nothing at all. Every condition now has a default <li>.
    * OVERALL STATUS. "Is everything ok" checks the three safety sensors.

  PREDICATES this file expects ai.py to set before responding to CHECK SENSOR:

      sensor            SMOKE | FLAME | IR | MOTION | FALL | TEMPERATURE
                        | HUMIDITY | ALL
      smoke_status      clear | elevated | alarm      (or true / false)
      flame_status      clear | detected | alarm      (or true / false)
      ir_status         true | false
      motion_status     true | false
      fall_status       idle | freefall | impact | fallen
      temperature       number, degrees C
      humidity          number, percent
      safety_status     ok | warning | alarm          (for ALL)

  Any predicate left unset falls to the default branch and Genie says it
  cannot read that sensor, rather than saying nothing.
-->

<aiml version="2.0">

    <!-- ====================================================== -->
    <!--                    MQ-2 SMOKE SENSOR                   -->
    <!-- ====================================================== -->

    <category>
        <pattern>CHECK SMOKE SENSOR</pattern>
        <template><think><set name="sensor">SMOKE</set></think></template>
    </category>

    <category><pattern>I THINK SOMEONE IS SMOKING</pattern>
        <template><srai>CHECK SMOKE SENSOR</srai></template></category>
    <category><pattern>SOMEONE IS SMOKING</pattern>
        <template><srai>CHECK SMOKE SENSOR</srai></template></category>
    <category><pattern>IS SOMEONE SMOKING</pattern>
        <template><srai>CHECK SMOKE SENSOR</srai></template></category>
    <category><pattern>DO YOU THINK SOMEONE IS SMOKING</pattern>
        <template><srai>CHECK SMOKE SENSOR</srai></template></category>
    <category><pattern>I THINK THERE IS SMOKE</pattern>
        <template><srai>CHECK SMOKE SENSOR</srai></template></category>
    <category><pattern>I SMELL SMOKE</pattern>
        <template><srai>CHECK SMOKE SENSOR</srai></template></category>
    <category><pattern>DO YOU SMELL SMOKE</pattern>
        <template><srai>CHECK SMOKE SENSOR</srai></template></category>
