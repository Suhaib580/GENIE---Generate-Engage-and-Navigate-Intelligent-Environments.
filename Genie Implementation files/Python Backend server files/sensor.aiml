    <!-- ====================================================== -->
    <!--        DISTANCE  -  the 4x VL53L1X ToF array           -->
    <!-- ====================================================== -->
    <!--
      Added 26-08-2026 with the ToF array. The IR categories above answer
      "is something there"; these answer "how far, and which way", which
      an IR gate could never do and four ToF sensors can.

      Predicates ai.py sets:
          distance        nearest valid reading, millimetres
          distance_side   front | left | right | rear
    -->

    <category>
        <pattern>CHECK DISTANCE SENSOR</pattern>
        <template><think><set name="sensor">DISTANCE</set></think></template>
    </category>

    <!-- ====================================================== -->
    <!--   PRESENCE  -  is anyone in the ROOM (any ToF side)    -->
    <!-- ====================================================== -->
    <!--
      Separate from MOTION on purpose. MOTION below is about the UNIT
      being moved; this is about a PERSON being nearby. Answering one
      with the other had GENIE saying "I felt a change in my position"
      because somebody walked past it.

      Separate from IR too: IR is the front sensor only, this is any of
      the four.
    -->

    <category>
        <pattern>CHECK PRESENCE SENSOR</pattern>
        <template><think><set name="sensor">PRESENCE</set></think></template>
    </category>

    <category><pattern>IS ANYONE IN THE ROOM</pattern>
        <template><srai>CHECK PRESENCE SENSOR</srai></template></category>
    <category><pattern>IS SOMEONE IN THE ROOM</pattern>
        <template><srai>CHECK PRESENCE SENSOR</srai></template></category>
    <category><pattern>IS ANYBODY IN THE ROOM</pattern>
        <template><srai>CHECK PRESENCE SENSOR</srai></template></category>
