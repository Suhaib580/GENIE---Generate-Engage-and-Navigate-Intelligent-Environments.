    <!-- ====================================================== -->
    <!--              OVERALL STATUS  -  ALL SENSORS            -->
    <!-- ====================================================== -->

    <category>
        <pattern>CHECK EVERYTHING</pattern>
        <template><think><set name="sensor">ALL</set></think></template>
    </category>

    <category><pattern>IS EVERYTHING OK</pattern>
        <template><srai>CHECK EVERYTHING</srai></template></category>
    <category><pattern>IS EVERYTHING SAFE</pattern>
        <template><srai>CHECK EVERYTHING</srai></template></category>
